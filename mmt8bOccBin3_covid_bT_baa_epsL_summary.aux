\newlabel{sec:data}{{2.1}{5}{}{subsection.2.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Observable construction. \texttt  {OPHNFB} is nonfarm business sector output per hour (labor productivity), used to detrend output and deposits. \texttt  {BAA} (Moody's Seasoned Baa Corporate Bond Yield, monthly) replaces the bank prime rate (\texttt  {MPRIME}) used in earlier versions of this model. \texttt  {FYGFDPUN} (Federal Debt Held by the Public, quarterly, millions of dollars) replaces \texttt  {GFDEBTN} (gross/total public debt); it is divided by 1000 before forming the ratio because \texttt  {FYGFDPUN} is reported in millions of dollars while \texttt  {GDP} is reported in billions. $q$ subscripts denote quarterly averages of monthly series.}}{5}{}\protected@file@percent }
\newlabel{tab:data}{{2}{5}{}{table.2}{}}
